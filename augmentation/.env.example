# =============================================================================
# Plantilla de configuración. Copia este archivo a .env y rellena tus valores:
#
#   cp .env.example .env
#
# El archivo .env está en .gitignore y NO se sube a git.
# =============================================================================

# Token de Hugging Face con permiso de ESCRITURA.
# Créalo en: https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# Repo destino en Hugging Face (formato: usuario/nombre-dataset).
HF_REPO_ID=tu-usuario/triatominos-augmentado

# Ruta local del dataset original (carpetas por género/especie).
DATASET_PATH=/ruta/a/tu/dataset

# Objetivo total de imágenes augmentadas (recomendado entre 20000 y 40000).
TARGET_TOTAL=30000

# Tamaño de salida estandarizado (píxeles, imagen cuadrada).
IMG_SIZE=224

# --- Opcionales (puedes dejarlos como están) ---------------------------------
# Nº de imágenes por commit al subir a Hugging Face.
TAMANO_LOTE_COMMIT=500
# Reintentos ante fallos de red al subir un lote.
REINTENTOS_SUBIDA=4
# Calidad de la codificación JPEG en memoria (1-100).
CALIDAD_JPEG=95
